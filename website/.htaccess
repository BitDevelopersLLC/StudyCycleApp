# Apache settings for studycycle.app (HostGator).
# Replaces the old WordPress .htaccess.

# Serve index.html for "/", never a leftover WordPress index.php
# (which the rules below redirect to "/", so it would loop).
DirectoryIndex index.html

RewriteEngine On

# Certificate renewal (AutoSSL / Let's Encrypt) must always work:
# nothing below ever redirects or rewrites /.well-known/.
RewriteRule ^\.well-known/ - [L]

# Always use HTTPS. Browsers require it for .app domains anyway.
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# One address for search engines: www.studycycle.app -> studycycle.app
RewriteCond %{HTTP_HOST} ^www\.studycycle\.app$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://studycycle.app%{REQUEST_URI} [L,R=301]

# Old WordPress addresses that may still be bookmarked or indexed go to the home page.
# The "?" at the end of the target drops the old query string.
#   /wp-admin, /wp-content/..., /wp-login.php, /wp-json/..., /wp-sitemap.xml, /xmlrpc.php,
#   /index.php, /feed/, /comments/feed/, /any-post/feed/, /author/..., /category/..., /tag/...
RewriteRule ^(wp-.*|xmlrpc\.php|index\.php|(.*/)?feed/?|(author|category|tag)/.*)$ https://studycycle.app/? [NC,L,R=301]
#   /?p=123, /?page_id=2, /?cat=1, /?s=word, /?feed=rss2 and similar
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|cat|tag|s|author|attachment_id|feed|m|preview)= [NC]
RewriteRule ^$ https://studycycle.app/? [L,R=301]
# WordPress's default privacy page address
RewriteRule ^privacy-policy/?$ https://studycycle.app/privacy [NC,L,R=301]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://studycycle.app/ [L,R=301]

# /privacy.html -> /privacy (the address the app and the stores use)
RewriteCond %{THE_REQUEST} \s/privacy\.html[\s?] [NC]
RewriteRule ^privacy\.html$ https://studycycle.app/privacy [L,R=301]

# /privacy and /privacy/ show privacy.html (no redirect; the old WordPress URL keeps working)
RewriteRule ^privacy/?$ privacy.html [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Everything is served from this site; nothing loads from elsewhere.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  # The web timer (/app/) runs its own two script files and nothing else. connect-src 'none'
  # means it can't send anything anywhere, even if its code were changed.
  <If "%{REQUEST_URI} =~ m#^/app/#">
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  </If>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

ErrorDocument 404 /404.html
